APP_NAME=Local Message Routing Agent
API_PREFIX=/api/v1
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_PREDICT=512
OLLAMA_WAIT_TIMEOUT_SECONDS=120
OLLAMA_WARMUP_ENABLED=true
OLLAMA_WARMUP_TIMEOUT_SECONDS=180
OLLAMA_PULL_MAX_ATTEMPTS=3
OLLAMA_PULL_RETRY_DELAY_SECONDS=5
OLLAMA_MODEL_EXPECTED_DIGEST=
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=no-reply@local-message-routing-agent.test
REQUEST_TIMEOUT_SECONDS=120
MESSAGE_MAX_LENGTH=5000
SMTP_TIMEOUT_SECONDS=10
MAX_CONCURRENT_ROUTE_REQUESTS=8
MAX_REQUEST_BODY_BYTES=65536
